{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/doctor.sh)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format --check:*)",
      "Bash(uv --version)",
      "Bash(uv run python -V)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm -v)",
      "Bash(node -v)",
      "Bash(ffprobe:*)",
      "Bash(ffmpeg -version)",
      "Bash(ffmpeg -hide_banner -filters)",
      "Bash(ffmpeg -hide_banner -encoders)",
      "Bash(ffmpeg -hide_banner -decoders)",
      "Bash(ffmpeg -hide_banner -formats)",
      "Bash(magick --version)",
      "Bash(magick -list:*)",
      "Bash(magick identify:*)",
      "Bash(fc-list:*)",
      "Bash(fc-match:*)",
      "Bash(hb-shape:*)",
      "Bash(sqlite3 -readonly:*)",
      "Bash(curl -s http://127.0.0.1:8000/api/health)",
      "Bash(curl -s http://127.0.0.1:8000/api/engines)",
      "Bash(curl -s http://127.0.0.1:8000/api/themes)",
      "Bash(curl -s http://127.0.0.1:8000/api/voices)",
      "Bash(lsof -nP -iTCP:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git stash list)",
      "Bash(git check-ignore:*)"
    ],
    "deny": [
      "Bash(git stash:*)",
      "Bash(git stash push:*)",
      "Bash(git stash save:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout .)",
      "Bash(git checkout -- :*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)"
    ]
  }
}
