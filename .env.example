# Copy to .env and fill in. .env is gitignored; this file is committed.
# Only the providers you actually select in config need to be populated.

# --- Script generation (LLM) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Audio: speech synthesis + word-level alignment ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Defaults (non-secret; safe to override per project) ---
VIDEO_DEFAULT_LLM_PROVIDER=gemini
VIDEO_DEFAULT_LLM_MODEL=gemini-3.7-flash
VIDEO_DEFAULT_TTS_PROVIDER=deepgram
VIDEO_DEFAULT_TTS_VOICE=aura-2-thalia-en
VIDEO_DEFAULT_ALIGNER=deepgram
VIDEO_DEFAULT_ALIGNER_MODEL=nova-3
VIDEO_OUTPUT_DIR=./out
VIDEO_CACHE_DIR=./cache
